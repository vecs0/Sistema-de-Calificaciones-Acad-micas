<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Datos.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Mi aplicación ASP.NET</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <!-- Google Fonts preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />

    <!-- Bundles CSS -->
    <webopt:bundlereference runat="server" path="~/Content/css" />

    <!-- Redesigned stylesheet (overrides defaults) -->
    <link href="~/Content/site-rediseno.css" rel="stylesheet" />

    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <!-- OVERRIDE FINAL — domina sobre Bootstrap y site-rediseno.css -->
    <link href="<%: ResolveUrl("~/Content/site-override.css") %>" rel="stylesheet" type="text/css" />

</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
          <Scripts>
            <asp:ScriptReference Name="MsAjaxBundle" />
            <asp:ScriptReference Name="jquery" />
            <asp:ScriptReference Name="WebForms.js"        Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
            <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
            <asp:ScriptReference Name="MenuStandards.js"   Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
            <asp:ScriptReference Name="GridView.js"        Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
            <asp:ScriptReference Name="DetailsView.js"     Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
            <asp:ScriptReference Name="TreeView.js"        Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
            <asp:ScriptReference Name="WebParts.js"        Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
            <asp:ScriptReference Name="Focus.js"           Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
            <asp:ScriptReference Name="WebFormsBundle" />
          </Scripts>
        </asp:ScriptManager>

        <!-- ════════ NAVBAR ════════ -->
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
          <div class="container">

            <!-- Brand -->
            <a class="navbar-brand" runat="server" href="~/">
              <div class="brand-icon">
                <svg viewBox="0 0 24 24">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                  <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                </svg>
              </div>
              <div class="nav-brand-text">
                <strong>Sistema de Calificaciones</strong>
                <span>Gestión académica · Facultad 2026</span>
              </div>
            </a>

            <!-- Toggler móvil -->
            <button type="button" class="navbar-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse"
                    title="Menú"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
              <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Links -->
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
              <ul class="navbar-nav flex-grow-1">

                <li class="nav-item">
                  <a class="nav-link" runat="server" href="~/" id="navInicio">
                    <svg class="nav-icon" viewBox="0 0 24 24">
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                      <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    Inicio
                  </a>
                </li>

                <li class="nav-item">
                  <a class="nav-link" runat="server" href="~/About" id="navDocs">
                    <svg class="nav-icon" viewBox="0 0 24 24">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                      <polyline points="14 2 14 8 20 8"/>
                      <line x1="16" y1="13" x2="8" y2="13"/>
                      <line x1="16" y1="17" x2="8" y2="17"/>
                      <polyline points="10 9 9 9 8 9"/>
                    </svg>
                    Documentación
                  </a>
                </li>

                <li class="nav-item">
                  <a class="nav-link" runat="server" href="~/Contact" id="navGrilla">
                    <svg class="nav-icon" viewBox="0 0 24 24">
                      <line x1="8" y1="6" x2="21" y2="6"/>
                      <line x1="8" y1="12" x2="21" y2="12"/>
                      <line x1="8" y1="18" x2="21" y2="18"/>
                      <line x1="3" y1="6" x2="3.01" y2="6"/>
                      <line x1="3" y1="12" x2="3.01" y2="12"/>
                      <line x1="3" y1="18" x2="3.01" y2="18"/>
                    </svg>
                    Grilla de Ordenamiento
                    <span class="nav-tag">DEMO</span>
                  </a>
                </li>

                <li class="nav-sep" aria-hidden="true" role="separator"></li>

                <li class="nav-item">
                  <a class="nav-link nav-badge" runat="server" href="~/Tect" id="navSistema">
                    <span class="nav-badge-dot" aria-hidden="true"></span>
                    Sistema de Calificaciones
                  </a>
                </li>

              </ul>

              <!-- Theme toggle (decorativo; JS en scripts) -->
              <div class="theme-toggle" id="themeToggle" title="Alternar tema">☀</div>
            </div>
          </div>
        </nav>

        <!-- ════════ CONTENIDO PRINCIPAL ════════ -->
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
            <footer>
                <p>&copy; <%: DateTime.Now.Year %> &mdash; Sistema Académico · ASP.NET Framework 4.7.2</p>
                <div class="footer-right">
                    <span class="footer-dot"></span>
                    <span>Sistema Académico</span>
                    <span class="footer-dot"></span>
                    <span>Facultad 2026</span>
                </div>
            </footer>
        </div>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>

    <%-- ══ SCRIPT: marcar nav-link activo según la URL actual ══ --%>
    <script type="text/javascript">
    (function () {
        var path = window.location.pathname.toLowerCase();

        var map = [
            { id: 'navInicio',  patterns: ['/default', '/home', '/'] },
            { id: 'navDocs',    patterns: ['/about'] },
            { id: 'navGrilla',  patterns: ['/contact'] },
            { id: 'navSistema', patterns: ['/tect', '/calificaciones'] }
        ];

        map.forEach(function (item) {
            var el = document.getElementById(item.id);
            if (!el) return;
            var match = item.patterns.some(function (p) {
                return path === p || path.indexOf(p) !== -1;
            });
            if (match) {
                el.classList.add('nav-active');
            }
        });

        /* Fallback: si ninguno coincidió y la ruta es "/" exacto,
           marcar Inicio */
        if (path === '/' || path === '') {
            var ini = document.getElementById('navInicio');
            if (ini) ini.classList.add('nav-active');
        }
    })();

    /* ── Theme toggle con persistencia ── */
    (function () {
        var KEY = 'tect-theme';
        var btn = document.getElementById('themeToggle');
        if (!btn) return;

        /* Aplicar tema guardado al cargar */
        var saved = localStorage.getItem(KEY);
        if (saved === 'light') {
            document.body.classList.add('light-theme');
            document.body.classList.add('light');
            btn.textContent = '\u263E';
        }

        btn.addEventListener('click', function () {
            if (!btn) return;
            var isLight = document.body.classList.toggle('light-theme');
            document.body.classList.toggle('light', isLight);
            btn.textContent = isLight ? '\u263E' : '\u2600';
            localStorage.setItem(KEY, isLight ? 'light' : 'dark');
        });
    })();
    </script>

</body>
</html>
